{
  "name": "@item-enonic-types/lib-turbo-streams",
  "sideEffects": false,
  "description": "Type definitions for lib-xp-turbo",
  "author": "Tom Arild Jakobsen <tajakobsen@gmail.com>",
  "version": "2.0.0-beta.1",
  "license": "MIT",
  "types": "dist/lib/turbo-streams/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "tsconfig.json"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ItemConsulting/lib-xp-turbo.git"
  },
  "engines": {
    "node": ">=24.18.0"
  },
  "peerDependencies": {
    "@enonic-types/core": "^8.1.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@changesets/cli": "^3.0.3",
    "@enonic-types/global": "8.1.0",
    "@enonic-types/core": "8.1.0",
    "@enonic-types/lib-sse": "8.1.0",
    "@enonic-types/lib-context": "8.1.0",
    "@swc/core": "^1.16.18",
    "@types/node": "^24",
    "concurrently": "^10.0.6",
    "tsdown": "^0.23.1",
    "typescript": "^7.0.2"
  },
  "bugs": {
    "url": "https://github.com/ItemConsulting/lib-xp-turbo/issues"
  },
  "homepage": "https://github.com/ItemConsulting/lib-xp-turbo#readme",
  "private": false,
  "scripts": {
    "build": "tsdown",
    "check": "concurrently -c auto -g --timings npm:check:types npm:lint",
    "check:types": "concurrently --kill-others-on-fail -g -r --timings npm:check:types:*",
    "check:types:server": "tsc --noEmit -p src/main/resources/tsconfig.json",
    "check:types:tests": "tsc --noEmit -p src/test/tsconfig.json",
    "lint": "biome ci",
    "lint:fix": "biome check --write",
    "release": "changeset publish",
    "versioning": "changeset version && npm i --package-lock-only && node .changeset/gradle-version.mjs",
    "prepublishOnly": "tsc --project src/main/resources/tsconfig.json --declarationDir dist --emitDeclarationOnly true --declaration true",
    "postpublish": "rm -r ./dist",
    "test": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --import ./src/test/register.mjs --test src/test/*.test.mts",
    "cov": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --import ./src/test/register.mjs --test --experimental-test-coverage src/test/*.test.mts"
  }
}
