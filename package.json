{
  "name": "@item-enonic-types/lib-turbo-streams",
  "sideEffects": false,
  "description": "Type definitions for lib-xp-turbo",
  "author": "Tom Arild Jakobsen <tajakobsen@gmail.com>",
  "version": "1.1.2",
  "license": "MIT",
  "types": "dist/lib/turbo-streams/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "tsconfig.json"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ItemConsulting/lib-xp-turbo.git"
  },
  "engines": {
    "node": ">=24.18.0"
  },
  "peerDependencies": {
    "@enonic-types/core": "^8.0.0 || ^8.1.0-0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.14",
    "@changesets/cli": "^3.0.3",
    "@enonic-types/global": "8.1.0-B3",
    "@enonic-types/core": "8.1.0-B3",
    "@enonic-types/lib-sse": "8.1.0-B3",
    "@enonic-types/lib-context": "8.1.0-B3",
    "@swc/core": "^1.16.2",
    "@types/node": "^26.0.0",
    "concurrently": "^10.0.5",
    "tsdown": "^0.23.0",
    "typescript": "^7.0.2"
  },
  "bugs": {
    "url": "https://github.com/ItemConsulting/lib-xp-turbo/issues"
  },
  "homepage": "https://github.com/ItemConsulting/lib-xp-turbo#readme",
  "private": false,
  "scripts": {
    "build": "tsdown",
    "check": "concurrently -c auto -g --timings npm:check:types npm:lint",
    "check:types": "tsc --noEmit -p src/main/resources/tsconfig.json",
    "lint": "biome ci",
    "lint:fix": "biome check --write",
    "release": "changeset publish",
    "versioning": "changeset version && npm i --package-lock-only && NEW_VERSION=$(node -p \"require('./package.json').version\") && sed -i -E \"s/^version *=.*/version = ${NEW_VERSION}/\" gradle.properties",
    "prepublishOnly": "tsc --project src/main/resources/tsconfig.json --declarationDir dist --emitDeclarationOnly true --declaration true",
    "postpublish": "rm -r ./dist"
  }
}
